{
  "name": "@rfranr/memory-cli",
  "version": "1.0.0",
  "description": "Experimental CLI for local document indexing with embeddings and semantic search.",
  "main": "dist/index.js",
  "bin": {
    "memory-cli": "dist/index.js",
    "rag-cli": "dist/index.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "https://github.com/rfranr/memory-cli.git" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --loader ts-node/esm src/index.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "sqlite": "^5.1.1",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^5.1.7"
  }
}
