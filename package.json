    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "sqlite": "^5.1.1",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^5.1.7"
  }
}
