{
  "name": "rag-cli",
  "version": "1.0.0",
  "description": "Experimental CLI for indexing documents with local embeddings, automatic tagging, and semantic RAG-style search.",
  "main": "dist/index.js",
  "bin": {
    "rag-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/index.ts",
    "test": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
