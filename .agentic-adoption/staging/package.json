{
  "name": "agentic-dev-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "format": "prettier --write \"{src,tests}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,js,mjs}\"",
    "lint": "eslint src/ tests/ scripts/",
    "complexity": "node scripts/complexity-report.mjs",
    "metrics": "tsmetrics analyze ./src ./tests",
    "metrics:html": "tsmetrics analyze ./src ./tests --format html > metrics.html",
    "dependencies": "depcruise --config .dependency-cruiser.cjs -T err src/ tests/*.ts",
    "structure": "node scripts/run-structure.mjs",
    "check": "npm run lint && npm test && npm run build",
    "check:report": "node scripts/check-report.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsmetrics": "^0.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tsmetrics@0.4.0": true
  }
}
